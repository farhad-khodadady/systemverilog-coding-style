# Store text with LF in the repository and check it out with LF on every OS,
# so Windows and Linux users get identical files and the linters see the same bytes.
* text=auto eol=lf

*.sv      text eol=lf linguist-language=SystemVerilog
*.svh     text eol=lf linguist-language=SystemVerilog
*.md      text eol=lf
Makefile  text eol=lf
LICENSE*  text eol=lf
